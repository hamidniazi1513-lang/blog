<!DOCTYPE html>
<html>
  <head>
    <title>Blog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      body { max-width: 850px; margin: 2rem auto; padding: 0 1rem; font: 16px/1.5 Arial, sans-serif; color: #222; }
      a { color: #155eef; } textarea, input[type=text] { width: 100%; padding: .6rem; margin: .3rem 0 1rem; box-sizing: border-box; }
      textarea { min-height: 130px; } .notice { color: green; } .error { color: #b42318; }
      article { border-bottom: 1px solid #ddd; padding: 1rem 0; }
    </style>
  </head>
  <body>
    <p class="notice"><%= notice %></p>
    <p class="error"><%= alert %></p>
    <%= yield %>
  </body>
</html>
