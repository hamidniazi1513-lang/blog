<%= form_with(model: [@post, @comment]) do |form| %>
  <% if @comment.errors.any? %>
    <div role="alert">
      <h2><%= pluralize(@comment.errors.count, "error") %> prevented this comment from being saved:</h2>
      <ul><% @comment.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= form.label :body, "Comment" %>
    <%= form.text_area :body, rows: 4, required: true %>
  </div>
  <div><%= form.submit "Save comment" %></div>
<% end %>
